{
  "name": "@buildiq/design-tokens",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./tokens.json": "./tokens.json",
    "./css": "./dist/tokens.css"
  },
  "scripts": {
    "build": "tsx scripts/build.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/**/*.test.ts"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "tsx": "^4.23.5",
    "typescript": "^5.8.2"
  }
}
