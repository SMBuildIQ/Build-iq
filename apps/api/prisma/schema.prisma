generator client {
  provider = "prisma-client-js"
  // Isolated from legacy root SQLite @prisma/client
  output   = "../node_modules/@buildiq/prisma-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  PROJECT_MANAGER
  SUPERINTENDENT
  ESTIMATOR
  PURCHASING
  ACCOUNTANT
  DESIGNER
  SALES
  SUBCONTRACTOR
  SUPPLIER
  HOMEOWNER
  VIEWER
}

enum ProjectStatus {
  DRAFT
  ANALYZING
  ESTIMATED
  BIDDING
  SYNCED
  ARCHIVED
}

enum ProposalStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  DECLINED
  EXPIRED
  SUPERSEDED
}

enum OrderStatus {
  PLACED
  CONFIRMED
  FULFILLING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum CabinetryStage {
  NEW
  DOCUMENTS_REQUESTED
  ESTIMATING
  PROPOSAL_SENT
  ACCEPTED
  LOST
  EXPIRED
}

model Company {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  phone     String?
  city      String?
  state     String?
  onboarded Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members                Membership[]
  projects               Project[]
  cart                   Cart?
  orders                 Order[]
  customers              Customer[]
  cabinetryOpportunities CabinetryOpportunity[]
  proposals              Proposal[]
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String
  passwordHash    String
  tokenVersion    Int       @default(0)
  termsAcceptedAt DateTime?
  emailVerifiedAt DateTime?
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  memberships Membership[]
}

model Membership {
  id        String   @id @default(cuid())
  role      Role     @default(OWNER)
  createdAt DateTime @default(now())

  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([companyId])
}

model Project {
  id         String        @id @default(cuid())
  name       String
  address    String?
  city       String?
  state      String?
  zip        String?
  squareFeet Int?
  stories    Int           @default(1)
  status     ProjectStatus @default(DRAFT)
  notes      String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdById String?
  customerId  String?
  customer    Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  blueprints             Blueprint[]
  materials              MaterialItem[]
  estimate               Estimate?
  cabinetryOpportunities CabinetryOpportunity[]
  proposals              Proposal[]

  @@index([companyId, status])
}

model Blueprint {
  id           String   @id @default(cuid())
  filename     String
  originalName String
  mimeType     String
  sizeBytes    Int
  sheetType    String?
  pageCount    Int      @default(1)
  analysisJson String?
  scanStatus   String   @default("IDLE")
  createdAt    DateTime @default(now())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model MaterialItem {
  id          String  @id @default(cuid())
  category    String
  trade       String
  name        String
  description String?
  quantity    Float
  unit        String
  unitCost    Float
  laborHours  Float   @default(0)
  laborRate   Float   @default(0)
  wasteFactor Float   @default(0.1)
  spruceSku   String?
  source      String  @default("ai")
  confidence  Float?

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Estimate {
  id              String   @id @default(cuid())
  materialCost    Float
  laborCost       Float
  wasteCost       Float
  contingencyPct  Float    @default(0.1)
  contingencyCost Float
  overheadPct     Float    @default(0.08)
  overheadCost    Float
  profitPct       Float    @default(0.12)
  profitAmount    Float
  taxPct          Float    @default(0.065)
  taxAmount       Float
  grandTotal      Float
  version         Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  type      String   @default("BUILDER")
  email     String?
  phone     String?
  address   String?
  city      String?
  state     String?
  zip       String?
  notes     String?
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  projects               Project[]
  opportunities          CabinetryOpportunity[]
  proposals              Proposal[]

  @@index([companyId, name])
}

model Proposal {
  id                 String         @id @default(cuid())
  number             String
  title              String
  status             ProposalStatus @default(DRAFT)
  version            Int            @default(1)
  intro              String?
  scopeNotes         String?
  exclusions         String?
  terms              String?
  validUntil         DateTime?
  depositPct         Float          @default(0.3)
  materialSubtotal   Float          @default(0)
  laborSubtotal      Float          @default(0)
  wasteSubtotal      Float          @default(0)
  contingencyAmount  Float          @default(0)
  overheadAmount     Float          @default(0)
  profitAmount       Float          @default(0)
  taxAmount          Float          @default(0)
  grandTotal         Float          @default(0)
  depositAmount      Float          @default(0)
  publicToken        String         @unique @default(cuid())
  sentAt             DateTime?
  viewedAt           DateTime?
  acceptedAt         DateTime?
  declinedAt         DateTime?
  customerEmail      String?
  customerName       String?
  projectAddress     String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  createdById        String?

  companyId              String
  company                Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  projectId              String?
  project                Project?              @relation(fields: [projectId], references: [id], onDelete: SetNull)
  customerId             String?
  customer               Customer?             @relation(fields: [customerId], references: [id], onDelete: SetNull)
  cabinetryOpportunityId String?

  sections   ProposalSection[]
  acceptance ProposalAcceptance?

  @@unique([companyId, number])
  @@index([companyId, status])
  @@index([projectId])
  @@index([publicToken])
}

model ProposalSection {
  id        String  @id @default(cuid())
  category  String
  title     String
  sortOrder Int     @default(0)
  subtotal  Float   @default(0)
  notes     String?

  proposalId String
  proposal   Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  lines ProposalLine[]

  @@index([proposalId, sortOrder])
}

model ProposalLine {
  id               String  @id @default(cuid())
  name             String
  description      String?
  category         String
  quantity         Float
  unit             String
  unitPrice        Float
  lineTotal        Float
  spruceSku        String?
  sortOrder        Int     @default(0)
  sourceMaterialId String?

  sectionId String
  section   ProposalSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([sectionId, sortOrder])
}

model ProposalAcceptance {
  id          String   @id @default(cuid())
  decision    String
  signerName  String
  signerEmail String?
  signerTitle String?
  notes       String?
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now())

  proposalId String   @unique
  proposal   Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
}

model Cart {
  id        String   @id @default(cuid())
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  companyId String  @unique
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  items CartItem[]
}

model CartItem {
  id        String   @id @default(cuid())
  /// Hardcoded shop package id/slug (no MaterialPackage table in v1 API)
  packageId String
  quantity  Int      @default(1)
  projectId String?
  unitPrice Float
  name      String
  category  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cartId String
  cart   Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)

  @@unique([cartId, packageId, projectId])
  @@index([cartId])
}

model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique
  status          OrderStatus @default(PLACED)
  trackingStep    String      @default("ORDER_RECEIVED")
  subtotal        Float
  tax             Float
  total           Float
  currency        String      @default("usd")
  paymentStatus   String      @default("pending")
  paymentMethod   String?
  paymentIntentId String?
  paidAt          DateTime?
  shipToName      String?
  shipToAddress   String?
  shipToCity      String?
  shipToState     String?
  shipToZip       String?
  notes           String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  companyId  String
  company    Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  placedById String?
  projectId  String?

  items OrderItem[]

  @@index([companyId, createdAt])
}

model OrderItem {
  id        String @id @default(cuid())
  name      String
  category  String
  quantity  Int
  unitPrice Float
  lineTotal Float
  packageId String?
  spruceSku String?

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model CabinetryOpportunity {
  id                    String         @id @default(cuid())
  stage                 CabinetryStage @default(NEW)
  status                String         @default("OPEN")
  version               Int            @default(1)
  builderName           String?
  architectName         String?
  designerName          String?
  projectAddress        String?
  requestedProposalDate DateTime?
  targetInstallDate     DateTime?
  constructionType      String?
  supplyScope           String?
  taxStatus             String?
  notes                 String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  createdById           String?

  companyId  String
  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  projectId  String?
  project    Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([companyId, stage])
  @@index([projectId])
  @@index([customerId])
}
