# PostgreSQL (apps/api Prisma — not the legacy root SQLite DB)
DATABASE_URL="postgresql://buildiq:buildiq@localhost:5432/buildiq?schema=public"

# Auth
JWT_SECRET="change-me-in-production-use-long-random-string"
JWT_EXPIRES_IN="7d"
PORT=4000

# Redis (optional — health reports degraded if missing)
REDIS_URL="redis://localhost:6379"

# S3-compatible object storage (optional — health reports degraded if missing)
S3_ENDPOINT="http://localhost:9000"
S3_BUCKET="buildiq"
S3_ACCESS_KEY="minio"
S3_SECRET_KEY="minio123"
S3_REGION="us-east-1"
