{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true,
    "paths": {
      "@buildiq/types": ["../../packages/types/src/index.ts"],
      "@buildiq/validation": ["../../packages/validation/src/index.ts"],
      "@buildiq/permissions": ["../../packages/permissions/src/index.ts"],
      "@buildiq/pricing": ["../../packages/pricing/src/index.ts"],
      "@buildiq/prisma-client": ["./node_modules/@buildiq/prisma-client"]
    }
  },
  "include": ["src/**/*", "prisma/seed.ts"],
  "exclude": ["node_modules", "dist"]
}
