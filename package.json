{
  "name": "buildiq-purchasing",
  "version": "0.1.0",
  "private": true,
  "description": "BuildIQ — multi-tenant AI-powered B2B purchasing platform.",
  "engines": {
    "node": ">=20"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "scripts": {
    "dev": "next dev",
    "worker": "tsx scripts/worker.ts",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "postinstall": "prisma generate",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/**/*.test.ts",
    "pretest:e2e": "DATABASE_URL=file:./e2e.db prisma db push --skip-generate --accept-data-loss",
    "test:e2e": "playwright test",
    "launch:check": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "jose": "^6.2.8",
    "lucide-react": "^1.28.0",
    "next": "^16.3.0",
    "otpauth": "^9.5.1",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.56.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "autoprefixer": "^10.5.4",
    "eslint": "^9",
    "eslint-config-next": "^16.3.0",
    "postcss": "^8",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.5",
    "typescript": "^5"
  }
}
