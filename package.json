{
  "name": "buildiq-platform",
  "version": "0.1.0",
  "private": true,
  "description": "BuildIQ monorepo — Expo · Next.js · NestJS · shared packages. Legacy Next soft-launch remains at repo root.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev -w @buildiq/api",
    "dev:web": "npm run dev -w @buildiq/web",
    "dev:mobile": "npm run start -w @buildiq/mobile",
    "build:packages": "npm run build -w @buildiq/design-tokens && npm run build -w @buildiq/types && npm run build -w @buildiq/validation && npm run build -w @buildiq/permissions && npm run build -w @buildiq/pricing",
    "build:platform": "npm run build:packages && npm run build -w @buildiq/api && npm run build -w @buildiq/web",
    "typecheck:platform": "npm run typecheck --workspaces --if-present",
    "test:platform": "npm run test --workspaces --if-present",
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "postinstall": "prisma generate",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/**/*.test.ts",
    "smoke": "bash scripts/smoke.sh",
    "launch:check": "npm run typecheck && npm test && npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@napi-rs/canvas": "^1.0.3",
    "@prisma/client": "^5.22.0",
    "@stripe/react-stripe-js": "^6.8.0",
    "@stripe/stripe-js": "^9.12.1",
    "bcryptjs": "^3.0.3",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "jose": "^6.2.8",
    "lucide-react": "^1.28.0",
    "next": "^16.3.0",
    "pdfjs-dist": "^6.2.108",
    "pdfkit": "^0.19.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "stripe": "^22.4.0",
    "tesseract.js": "^7.0.0",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@ducanh2912/next-pwa": "^10.2.9",
    "@eslint/eslintrc": "^3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "eslint": "^9",
    "eslint-config-next": "15.1.0",
    "postcss": "^8",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.5",
    "typescript": "^5"
  }
}
