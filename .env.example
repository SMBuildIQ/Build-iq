# Local dev default: SQLite. Production target: PostgreSQL (see ARCHITECTURE.md).
DATABASE_URL="file:./dev.db"

# 32+ random chars. Signs session JWTs.
AUTH_SECRET="dev-secret-change-in-production-please-32chars-min"

# AI provider abstraction (src/lib/ai). Leave unset to run the deterministic
# mock provider — extraction/recommendation flows stay fully testable offline.
AI_PROVIDER="mock"
ANTHROPIC_API_KEY=""
AI_MODEL="claude-sonnet-4-5"

NEXT_PUBLIC_APP_NAME="BuildIQ"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Email delivery (optional in dev — logs to console)
RESEND_API_KEY=""
EMAIL_FROM="BuildIQ <noreply@example.com>"

# Document storage (src/lib/documents/storage.ts). Leave unset for local disk
# (uploads/<organizationId>/...). Set STORAGE_DRIVER=s3 for an S3-compatible
# bucket (real AWS or any compatible endpoint — MinIO, etc.); S3_ENDPOINT and
# S3_FORCE_PATH_STYLE are only needed for non-AWS endpoints.
STORAGE_DRIVER="local"
S3_BUCKET=""
S3_REGION="us-east-1"
S3_ENDPOINT=""
S3_FORCE_PATH_STYLE="false"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
