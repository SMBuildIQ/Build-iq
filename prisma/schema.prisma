generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Company {
  id         String   @id @default(cuid())
  name       String
  slug       String   @unique
  phone      String?
  city       String?
  state      String?
  onboarded  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  members        Membership[]
  projects       Project[]
  invites        Invite[]
  spruceSettings SpruceSettings?
  cart           Cart?
  orders         Order[]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  /// Bumped to invalidate outstanding JWTs (logout-all / password change / delete).
  tokenVersion Int      @default(0)
  /// ISO timestamp when Terms + Privacy were accepted at signup.
  termsAcceptedAt DateTime?
  emailVerifiedAt DateTime?
  deletedAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships Membership[]
  authTokens  AuthToken[]
}

model Membership {
  id        String   @id @default(cuid())
  role      String   @default("OWNER")
  createdAt DateTime @default(now())

  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
}

model Invite {
  id         String    @id @default(cuid())
  code       String    @unique
  email      String?
  role       String    @default("ESTIMATOR")
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model Project {
  id         String   @id @default(cuid())
  name       String
  address    String?
  city       String?
  state      String?
  zip        String?
  squareFeet Int?
  stories    Int      @default(1)
  status     String   @default("DRAFT")
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  companyId   String
  company     Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdById String?

  blueprints  Blueprint[]
  materials   MaterialItem[]
  estimate    Estimate?
  bidPackages BidPackage[]
  spruceSyncs SpruceSyncLog[]
}

model Blueprint {
  id           String   @id @default(cuid())
  filename     String
  originalName String
  mimeType     String
  sizeBytes    Int
  sheetType    String?
  pageCount    Int      @default(1)
  analysisJson String?
  /// Raster preview used for vision/OCR (server-generated PNG filename under uploads/)
  previewFilename String?
  widthPx         Int?
  heightPx        Int?
  /// Calibrated scale: plan pixels per real-world unit (usually feet)
  pixelsPerUnit   Float?
  scaleUnit       String  @default("ft")
  scaleLabel      String?
  /// IDLE | SCANNING | READY | ERROR | PARTIAL
  scanStatus      String  @default("IDLE")
  scanError       String?
  scannedAt       DateTime?
  ocrText         String?
  ocrJson         String?
  visionJson      String?
  createdAt    DateTime @default(now())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  measurements PlanMeasurement[]
}

model PlanMeasurement {
  id          String   @id @default(cuid())
  /// CALIBRATION | LENGTH | AREA | COUNT | POLYLINE
  type        String
  label       String?
  /// JSON array of {x,y} in plan pixel space
  pointsJson  String
  /// Computed value in scale units (ft, sf) or count
  value       Float?
  unit        String?
  metaJson    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  blueprintId String
  blueprint   Blueprint @relation(fields: [blueprintId], references: [id], onDelete: Cascade)
}

model MaterialItem {
  id          String  @id @default(cuid())
  category    String
  trade       String
  name        String
  description String?
  quantity    Float
  unit        String
  unitCost    Float
  laborHours  Float   @default(0)
  laborRate   Float   @default(0)
  wasteFactor Float   @default(0.1)
  spruceSku   String?
  source      String  @default("ai")
  confidence  Float?

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  bidPackageId String?
  bidPackage   BidPackage? @relation(fields: [bidPackageId], references: [id], onDelete: SetNull)
}

model Estimate {
  id              String   @id @default(cuid())
  materialCost    Float
  laborCost       Float
  wasteCost       Float
  contingencyPct  Float    @default(0.1)
  contingencyCost Float
  overheadPct     Float    @default(0.08)
  overheadCost    Float
  profitPct       Float    @default(0.12)
  profitAmount    Float
  taxPct          Float    @default(0.065)
  taxAmount       Float
  grandTotal      Float
  version         Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model BidPackage {
  id          String    @id @default(cuid())
  trade       String
  title       String
  description String?
  dueDate     DateTime?
  status      String    @default("DRAFT")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  materials MaterialItem[]
}

model SpruceSettings {
  id            String   @id @default(cuid())
  apiEndpoint   String?
  soapEndpoint  String?
  apiKey        String?
  branchCode    String?
  accountNumber String?
  enabled       Boolean  @default(false)
  mockMode      Boolean  @default(true)
  updatedAt     DateTime @updatedAt

  companyId String  @unique
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model SpruceSyncLog {
  id        String   @id @default(cuid())
  action    String
  status    String
  detail    String?
  payload   String?
  createdAt DateTime @default(now())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// Catalog of residential material takeoff packages
model MaterialPackage {
  id          String   @id @default(cuid())
  slug        String   @unique
  category    String
  name        String
  description String
  contents    String
  unit        String   @default("package")
  unitPrice   Float
  leadDays    Int      @default(7)
  spruceSku   String?
  imageHint   String?
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  cartItems  CartItem[]
  orderItems OrderItem[]
}

model Cart {
  id        String   @id @default(cuid())
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  companyId String  @unique
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  items CartItem[]
}

model CartItem {
  id        String   @id @default(cuid())
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cartId    String
  cart      Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  packageId String
  package   MaterialPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  projectId String?

  @@unique([cartId, packageId, projectId])
}

model Order {
  id              String   @id @default(cuid())
  orderNumber     String   @unique
  status          String   @default("PLACED")
  trackingStep    String   @default("ORDER_RECEIVED")
  subtotal        Float
  tax             Float
  total           Float
  currency        String   @default("usd")
  paymentStatus   String   @default("pending")
  paymentMethod   String?
  paymentIntentId String?
  paidAt          DateTime?
  shipToName      String?
  shipToAddress   String?
  shipToCity      String?
  shipToState     String?
  shipToZip       String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  companyId   String
  company     Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  placedById  String?
  projectId   String?

  items    OrderItem[]
  tracking TrackingEvent[]
}

model OrderItem {
  id         String @id @default(cuid())
  name       String
  category   String
  quantity   Int
  unitPrice  Float
  lineTotal  Float
  spruceSku  String?

  orderId   String
  order     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  packageId String?
  package   MaterialPackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)
}

model TrackingEvent {
  id        String   @id @default(cuid())
  step      String
  label     String
  detail    String?
  createdAt DateTime @default(now())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model AuthToken {
  id        String   @id @default(cuid())
  type      String // EMAIL_VERIFY | PASSWORD_RESET
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

model LoginAttempt {
  id             String    @id @default(cuid())
  email          String    @unique
  failures       Int       @default(0)
  windowStartsAt DateTime  @default(now())
  lockedUntil    DateTime?
  updatedAt      DateTime  @updatedAt
}

model AuditLog {
  id          String   @id @default(cuid())
  companyId   String?
  actorUserId String?
  action      String
  entityType  String?
  entityId    String?
  detail      String?
  ip          String?
  createdAt   DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([actorUserId, createdAt])
}

/// Persisted AI agent orchestration run (multi-agent workflow).
model AgentRun {
  id          String    @id @default(cuid())
  /// e.g. estimating-pipeline
  workflowId  String
  status      String    @default("PENDING") // PENDING | RUNNING | COMPLETED | FAILED | CANCELLED
  progress    Int       @default(0)
  inputJson   String?
  resultJson  String?
  error       String?
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  companyId   String
  projectId   String?
  startedById String?

  steps AgentStep[]

  @@index([companyId, createdAt])
  @@index([projectId, createdAt])
  @@index([status, createdAt])
}

model AgentStep {
  id         String    @id @default(cuid())
  agentId    String
  agentName  String
  status     String    @default("PENDING") // PENDING | RUNNING | COMPLETED | FAILED | SKIPPED
  progress   Int       @default(0)
  message    String?
  inputJson  String?
  outputJson String?
  error      String?
  sortOrder  Int       @default(0)
  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  runId String
  run   AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, sortOrder])
  @@index([agentId, status])
}

/// Planned construction modules — schema placeholders for future implementation.
/// Do not expose fake CRUD; APIs return planned status until built.
model ModuleRegistry {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  status      String   @default("PLANNED") // PLANNED | PARTIAL | FULL
  description String?
  updatedAt   DateTime @updatedAt
}

