{
  "appId": "com.supplymonkey.buildiq",
  "appName": "BuildIQ",
  "webDir": "native-shell",
  "bundledWebRuntime": false,
  "server": {
    "url": "https://app.buildiq.com",
    "cleartext": false,
    "androidScheme": "https",
    "iosScheme": "https",
    "hostname": "app.buildiq.com",
    "allowNavigation": ["*.stripe.com", "*.buildiq.com", "app.buildiq.com"]
  },
  "ios": {
    "contentInset": "automatic",
    "preferredContentMode": "mobile",
    "scheme": "buildiq",
    "limitsNavigationsToAppBoundDomains": true
  },
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#161412",
    "webContentsDebuggingEnabled": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "launchAutoHide": true,
      "backgroundColor": "#161412",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "LIGHT",
      "backgroundColor": "#161412"
    },
    "Keyboard": {
      "resize": "body"
    }
  }
}
